  deadline_after: Time
}

# =============================================================================
# Query Type
# =============================================================================

type Query {
  # Dashboard (aggregated - primary GraphQL use case)
  dashboard: Dashboard!

  # Clients
  client(id: UUID!): Client
  clients(filter: ClientFilter, first: Int = 20, after: String): ClientConnection!

  # Documents
  document(id: UUID!): Document
  documents(filter: DocumentFilter, first: Int = 20, after: String): DocumentConnection!

  # Services
  service(id: UUID!): Service
  services(filter: ServiceFilter, first: Int = 20, after: String): ServiceConnection!

  # Emails
  email(id: UUID!): Email
  email_thread(id: UUID!): EmailThread

  # Notifications
  notifications(unread_only: Boolean = false, limit: Int = 20): [Notification!]!
  unread_notification_count: Int!

  # AI Chat (via Python proxy → MongoDB)
  ai_conversations(limit: Int = 20): [AIConversation!]!
  ai_conversation(id: String!): AIConversation

  # AI Analysis
  troublemaker_clients(limit: Int = 10): [TroublemakerClient!]!
  anomalies(limit: Int = 10): [AnomalyItem!]!

  # Search (unified)
  search(query: String!, limit: Int = 20): SearchResults!
  recent_searches(limit: Int = 5): [SearchResult!]!

  # Lookup types
  document_types: [DocumentType!]!
  service_types: [ServiceType!]!

  # Current user
  me: User!
}

# =============================================================================
# Mutation Type (Limited - most mutations use REST)
# =============================================================================

type Mutation {
  # Notifications
  mark_notification_read(id: UUID!): Notification!
  mark_all_notifications_read: Int!
  dismiss_notification(id: UUID!): Boolean!

  # Quick document actions
  approve_document(id: UUID!, note: String): Document!
  reject_document(id: UUID!, note: String!): Document!

  # Quick service actions
  update_service_status(id: UUID!, status: ServiceStatus!): Service!

  # Email actions
  claim_email(id: UUID!): Email!
  unclaim_email(id: UUID!): Email!
  mark_email_read(id: UUID!): Email!

  # AI Chat
  delete_ai_conversation(id: String!): Boolean!
}

# =============================================================================
# Subscription Type (Optional - WebSocket hub handles real-time)
# =============================================================================

type Subscription {
  notification_received: Notification!
  document_processed(client_id: UUID): Document!
  service_at_risk: Service!
}
