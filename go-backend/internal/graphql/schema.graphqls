# Accountant CRM GraphQL Schema
# Version: 1.0.0
# Generated from GRAPHQL.md specification

# =============================================================================
# Custom Scalars
# =============================================================================

scalar UUID
scalar Time
scalar JSON

# =============================================================================
# Enums
# =============================================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  PROSPECT
}

enum DocumentStatus {
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ServiceStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_INFO
  UNDER_REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ServicePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

