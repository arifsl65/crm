# =============================================================================
# Input Types
# =============================================================================

input ClientFilter {
  status: ClientStatus
  search: String
  assigned_to: UUID
  has_overdue_services: Boolean
  risk_score_min: Int
  risk_score_max: Int
}

input DocumentFilter {
  client_id: UUID
