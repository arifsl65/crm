# =============================================================================
# Accountant CRM - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
#
# Current Architecture (see cloud.md):
# - Single ECS server with Docker Compose
# - Neon PostgreSQL (free tier)
# - MongoDB Atlas (free tier)
# - Alibaba ApsaraDB Redis
# - Frontend served by nginx (static files via rsync)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
APP_NAME=accountant-crm
APP_DEBUG=true
LOG_LEVEL=debug                        # debug | info | warn | error

# -----------------------------------------------------------------------------
# Go Backend Service
# -----------------------------------------------------------------------------
GO_PORT=8080
GO_HOST=0.0.0.0
GO_READ_TIMEOUT=30s
GO_WRITE_TIMEOUT=30s
GO_SHUTDOWN_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Python AI Service
# -----------------------------------------------------------------------------
PYTHON_PORT=8000
PYTHON_HOST=0.0.0.0
PYTHON_WORKERS=4

# Python AI URL (for Go backend to call)
# Local dev: http://python-ai:8000 (Docker Compose service name)
# Production: http://python-ai:8000 (same Docker network on ECS)
PYTHON_AI_URL=http://python-ai:8000
PYTHON_AI_TIMEOUT=30s

# -----------------------------------------------------------------------------
# PostgreSQL (Neon - Free Tier)
# -----------------------------------------------------------------------------
# Get credentials from https://console.neon.tech
# IMPORTANT: Use app_user role (not neondb_owner) for RLS enforcement
POSTGRES_HOST=your-project.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=neondb
POSTGRES_SSLMODE=require
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=8                    # Neon free tier has 10-connection limit

# For migrations only (owner role with schema privileges)
NEON_MIGRATION_USER=neondb_owner
NEON_MIGRATION_PASSWORD=your-owner-password

# Full connection URL (alternative to individual settings)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=${POSTGRES_SSLMODE}

# -----------------------------------------------------------------------------
# MongoDB Atlas (Free Tier - AI Document Store)
# -----------------------------------------------------------------------------
# Get credentials from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=accountant_ai

# -----------------------------------------------------------------------------
# Redis (Alibaba ApsaraDB)
# -----------------------------------------------------------------------------
# Get credentials from Alibaba Cloud Console
REDIS_HOST=r-xxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_TLS_ENABLED=true
REDIS_POOL_SIZE=10

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-256-bit-secret-key-here
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d
JWT_ISSUER=accountant-crm

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Get API key from https://resend.com
EMAIL_API_KEY=re_your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Accountant CRM

# -----------------------------------------------------------------------------
# Frontend URL (for email links, redirects)
# -----------------------------------------------------------------------------
# Local dev: http://localhost:3000
# Production: https://crm.irislondonshoes.com (or your domain)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Local dev: http://localhost:3000
# Production: https://crm.irislondonshoes.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_IP=100
RATE_LIMIT_BURST_SIZE=20
RATE_LIMIT_WINDOW=1m

# -----------------------------------------------------------------------------
# External AI Services
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# OPTIONAL / FUTURE FEATURES
# =============================================================================
# The sections below are for features not yet implemented or disabled.
# Uncomment and configure when enabling these features.

# -----------------------------------------------------------------------------
# mTLS Configuration (Go <-> Python) - DISABLED
# -----------------------------------------------------------------------------
# Currently disabled - Go and Python communicate over Docker network
MTLS_ENABLED=false
# MTLS_CA_CERT=/certs/ca.crt
# MTLS_SERVER_CERT=/certs/server.crt
# MTLS_SERVER_KEY=/certs/server.key
# MTLS_CLIENT_CERT=/certs/client.crt
# MTLS_CLIENT_KEY=/certs/client.key

# -----------------------------------------------------------------------------
# Alibaba Cloud OSS (File Storage) - NOT CONFIGURED
# -----------------------------------------------------------------------------
# Enable when implementing document upload feature
# ALIBABA_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_ACCESS_KEY_SECRET=your-access-key-secret
# ALIBABA_REGION=eu-west-1
# OSS_ENDPOINT=https://oss-eu-west-1.aliyuncs.com
# OSS_BUCKET_UPLOADS=fzco-uploads

# -----------------------------------------------------------------------------
# Alibaba Cloud MNS (Message Service) - NOT IMPLEMENTED
# -----------------------------------------------------------------------------
# Enable when implementing event bus / async processing
# MNS_ENDPOINT=https://mns.eu-west-1.aliyuncs.com
# MNS_ACCOUNT_ID=your-account-id
# MNS_TOPIC_DOC_UPLOADED=doc-uploaded
# MNS_TOPIC_DOC_PROCESSED=doc-processed

# -----------------------------------------------------------------------------
# Monitoring & Observability - FUTURE
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=${APP_NAME}
# SENTRY_DSN=https://your-sentry-dsn
# METRICS_TOKEN=your-metrics-access-token
