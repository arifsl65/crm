# =============================================================================
# Accountant CRM - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
APP_NAME=accountant-crm
APP_DEBUG=true
LOG_LEVEL=debug                        # debug | info | warn | error

# -----------------------------------------------------------------------------
# Go Backend Service
# -----------------------------------------------------------------------------
GO_PORT=8080
GO_HOST=0.0.0.0
GO_READ_TIMEOUT=30s
GO_WRITE_TIMEOUT=30s
GO_SHUTDOWN_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Python AI Service
# -----------------------------------------------------------------------------
PYTHON_PORT=8000
PYTHON_HOST=0.0.0.0
PYTHON_WORKERS=4

# Python AI URL (for Go backend to call)
PYTHON_AI_URL=https://python-ai.fzco.local:8000
PYTHON_AI_TIMEOUT=30s

# -----------------------------------------------------------------------------
# PostgreSQL (Neon)
# -----------------------------------------------------------------------------
# Connection string format: postgresql://user:password@host:port/database?sslmode=require
POSTGRES_HOST=your-neon-host.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=accountant_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=accountant_crm
POSTGRES_SSLMODE=require
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=8                        # Neon has 10-connection limit

# Full connection URL (alternative to individual settings)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=${POSTGRES_SSLMODE}

# -----------------------------------------------------------------------------
# MongoDB Atlas (AI Document Store)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=accountant_ai
MONGODB_COLLECTION_DOCUMENTS=documents
MONGODB_COLLECTION_EMBEDDINGS=embeddings

# -----------------------------------------------------------------------------
# Redis (Alibaba ApsaraDB)
# -----------------------------------------------------------------------------
REDIS_HOST=redis.aliyuncs.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_TLS_ENABLED=true
REDIS_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Alibaba Cloud OSS
# -----------------------------------------------------------------------------
ALIBABA_ACCESS_KEY_ID=your-access-key-id
ALIBABA_ACCESS_KEY_SECRET=your-access-key-secret
ALIBABA_REGION=eu-west-1                       # UK (London)

OSS_ENDPOINT=https://oss-eu-west-1.aliyuncs.com
OSS_BUCKET_FRONTEND=fzco-frontend
OSS_BUCKET_UPLOADS=fzco-uploads
OSS_BUCKET_UPLOADS_STAGING=fzco-uploads-stg

# -----------------------------------------------------------------------------
# Alibaba Cloud MNS (Message Service)
# -----------------------------------------------------------------------------
MNS_ENDPOINT=https://mns.eu-west-1.aliyuncs.com
MNS_ACCOUNT_ID=your-account-id

# Topic names (per spec)
MNS_TOPIC_DOC_UPLOADED=doc-uploaded
MNS_TOPIC_DOC_PROCESSED=doc-processed
MNS_TOPIC_EMAIL_RECEIVED=email-received
MNS_TOPIC_SERVICE_AT_RISK=service-at-risk
MNS_TOPIC_CHASE_DUE=chase-due
MNS_TOPIC_USER_DELETED=user-deleted

# -----------------------------------------------------------------------------
# Alibaba Cloud ACR (Container Registry)
# -----------------------------------------------------------------------------
ACR_REGISTRY=registry.eu-west-1.aliyuncs.com
ACR_NAMESPACE=accountant-crm

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-256-bit-secret-key-here
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d
JWT_ISSUER=accountant-crm

# -----------------------------------------------------------------------------
# mTLS Configuration (Go <-> Python)
# -----------------------------------------------------------------------------
MTLS_ENABLED=true
MTLS_CA_CERT=/certs/ca.crt
MTLS_SERVER_CERT=/certs/server.crt
MTLS_SERVER_KEY=/certs/server.key
MTLS_CLIENT_CERT=/certs/client.crt
MTLS_CLIENT_KEY=/certs/client.key

# -----------------------------------------------------------------------------
# AI Feature Flags (Redis Keys)
# -----------------------------------------------------------------------------
AI_OCR_ENABLED=true
AI_CHAT_ENABLED=true
AI_FORMS_ENABLED=true
AI_CLASSIFICATION_ENABLED=true

# -----------------------------------------------------------------------------
# External AI Services
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=${APP_NAME}
SENTRY_DSN=https://your-sentry-dsn

# -----------------------------------------------------------------------------
# CDN Configuration
# -----------------------------------------------------------------------------
CDN_DOMAIN=cdn.yourdomain.com
CDN_REFRESH_TOKEN=your-cdn-refresh-token

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com
RATE_LIMIT_REQUESTS_PER_MINUTE=100
